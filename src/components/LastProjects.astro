---
import { getPages } from '../lib/notion';
import { mapPageData } from '../lib/parseNotion';
import type { ParsedPage } from '../types/ParsedPage';

// 🔁 Récupère et mappe toutes les pages en objets simplifiés
const rawPages = await getPages();
const parsedPages: ParsedPage[] = rawPages.map(mapPageData);

// 🎯 Filtre les réalisations ayant un statut "En ligne" ou "En Cours"
const projects = parsedPages
  .filter(p => ["En ligne", "En Cours"].includes(p.status ?? ""))
  .sort((a, b) => {
    if (!a.rank && !b.rank) return 0;
    if (!a.rank) return 1;
    if (!b.rank) return -1;
    return a.rank - b.rank;
  })
  .slice(0, 3); // On ne garde que les 3 dernières

---

<!-- mes réalisations -->
<section class="blog my-10">
  <div class="container mx-auto">
    <h2 class="blog__title h2 mb-[50px] text-left font-light">Nos dernières réalisations</h2>
    <!-- blog post -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6 items-center justify-between mb-[50px]">
      {projects.map((project) => {
        const isEnCours = project.status === "En Cours";

        return (
          <a
            href={isEnCours ? undefined : `/architecture-interieur/${project.slug}`}
            class={`h-full w-full xl:w-[380px] block ${
              isEnCours ? 'pointer-events-none cursor-default opacity-60' : 'group cursor-pointer'
            }`}
          >
            <div class="blog__post flex flex-col h-full shadow-custom2 rounded-[10px] overflow-hidden">
              <div class="relative overflow-hidden h-[344px]">
                {project.imagePresentation && (
                  <img 
                    class={`w-full h-full object-cover ${!isEnCours ? 'group-hover:scale-110 transition-all duration-500' : ''}`}
                    src={project.imagePresentation} 
                    alt={project.title}
                  />
                )}
                {isEnCours && (
                  <span class="absolute top-3 left-3 bg-yellow-500 text-white text-xs font-bold px-2 py-1 rounded shadow">
                    En cours
                  </span>
                )}
              </div>
              <div class="px-6 py-8 flex-1 flex flex-col">
                <h4 class="h4 mb-4 line-clamp-1">{project.title}</h4>
                <p class="font-light line-clamp-2 flex-1 text-[#4c5354]">
                  {project.excerpt}
                </p>
          
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
  <div class="container mx-auto flex justify-center mt-12">
		<a href="/realisations" class="btn btn-lg btn-accent">Tous les projets</a>
	</div>
</section>
<!-- mes réalisations end--> 
