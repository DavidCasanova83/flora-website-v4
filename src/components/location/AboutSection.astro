---
// src/components/location/AboutSection.astro
import type { AboutSection as AboutSectionType } from '../../types/Location';

interface Props {
  about: AboutSectionType;
}

const { about } = Astro.props;
---

<section class="my-10 xl:my-20">
  <div class="container mx-auto px-4 xl:px-24">
    <div class="flex flex-col xl:flex-row items-center gap-12">
      <!-- Text Content -->
      <div class="xl:w-3/5 text-left">
        <h2 class="h2 mb-6">
          {about.title}
        </h2>

        <div class="space-y-4">
          {about.paragraphs.map(paragraph => (
            <p class="text-[17px] leading-8 text-secondary font-light" set:html={paragraph} />
          ))}
        </div>

        <div class="mt-8 flex justify-center xl:justify-start">
          <a href={about.cta.url} class="btn btn-sm btn-accent">
            {about.cta.text}
          </a>
        </div>
      </div>

      <!-- Image -->
      <div class="xl:w-2/5">
        <img
          src={about.image}
          alt={about.imageAlt}
          class="w-full h-auto object-cover rounded-lg shadow-custom2"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
