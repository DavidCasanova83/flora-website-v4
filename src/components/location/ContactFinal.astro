---
// src/components/location/ContactFinal.astro
import type { ContactSection } from '../../types/Location';
import Icon from '../Icon.astro';

interface Props {
  contact: ContactSection;
}

const { contact } = Astro.props;
---

<section class="my-10 xl:my-20">
  <div class="newsletter bg-accent rounded-[10px] flex items-center justify-center xl:mx-56 mx-5 relative overflow-hidden py-12 xl:py-20">
    <div class="newsletter__container container mx-auto px-8">
      <!-- Title & Subtitle -->
      <div class="text-center mb-8">
        <h2 class="text-3xl xl:text-4xl font-light text-white mb-2">
          {contact.title}
        </h2>
        <p class="text-xl text-white font-light">
          {contact.subtitle}
        </p>
      </div>

      <!-- Accroche -->
      <p class="text-center text-white text-lg font-light mb-8 max-w-3xl mx-auto">
        {contact.accroche}
      </p>

      <div class="flex flex-col lg:flex-row lg:items-start lg:justify-center lg:gap-x-12 max-w-5xl mx-auto">
        <!-- Business Info -->
        <div class="flex-1 text-white space-y-4 mb-8 lg:mb-0">
          <h3 class="text-2xl font-semibold mb-6">{contact.businessInfo.label}</h3>

          <div class="flex items-start gap-3">
            <Icon name="mapPin" class="w-6 h-6 flex-shrink-0 mt-1" />
            <div>
              <p class="font-light">{contact.businessInfo.address}</p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <Icon name="phone" class="w-6 h-6 flex-shrink-0" />
            <a href={`tel:${contact.businessInfo.phone}`} class="font-light hover:underline">
              {contact.businessInfo.phone}
            </a>
          </div>

          <div class="flex items-center gap-3">
            <Icon name="mail" class="w-6 h-6 flex-shrink-0" />
            <a href={`mailto:${contact.businessInfo.email}`} class="font-light hover:underline">
              {contact.businessInfo.email}
            </a>
          </div>
        </div>

        <!-- CTA -->
        <div class="flex-1 flex flex-col justify-center items-center lg:items-start">
          <a href={contact.cta.url} class="btn btn-lg btn-white mb-4">
            {contact.cta.text}
          </a>
          <p class="text-white text-sm font-light text-center lg:text-left">
            {contact.message}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
