---
// src/components/location/ExpertiseSection.astro
import type { ExpertiseSection as ExpertiseSectionType } from '../../types/Location';

interface Props {
  expertise: ExpertiseSectionType;
}

const { expertise } = Astro.props;
---

<section class="my-10 xl:my-20">
  <div class="container mx-auto px-4">
    <!-- Title -->
    <h2 class="h2 text-center mb-12">
      {expertise.title}
    </h2>

    <div class="flex flex-col md:flex-row items-center gap-12">
      <!-- Image -->
      <div class="md:w-1/2">
        <img
          src={expertise.image}
          alt={expertise.imageAlt}
          class="w-full h-[400px] object-cover rounded-lg shadow-custom2"
          loading="lazy"
        />
      </div>

      <!-- Content -->
      <div class="md:w-1/2 space-y-8">
        {expertise.subsections.map(subsection => (
          <div>
            <h3 class="h3 mb-4">
              {subsection.h3}
            </h3>

            {subsection.content && (
              <p class="text-[17px] leading-8 text-secondary font-light mb-4">
                {subsection.content}
              </p>
            )}

            {subsection.points && (
              <ul class="space-y-3">
                {subsection.points.map(point => (
                  <li class="flex items-start gap-3">
                    <span class="text-accent text-xl mt-1">✓</span>
                    <span class="text-[17px] leading-8 text-secondary font-light">
                      {point}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
