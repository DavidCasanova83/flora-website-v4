---
// src/components/location/ZonesIntervention.astro
import type { ZonesSection } from '../../types/Location';

interface Props {
  zones: ZonesSection;
}

const { zones } = Astro.props;
---

<section class="my-10 xl:my-20 bg-grey py-12 xl:py-20">
  <div class="container mx-auto px-4">
    <!-- Title -->
    <h2 class="h2 text-center mb-6">
      {zones.title}
    </h2>

    <!-- Intro -->
    <p class="text-[17px] leading-8 text-secondary font-light text-center max-w-3xl mx-auto mb-12">
      {zones.intro}
    </p>

    <!-- Quartiers Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4 mb-12 max-w-5xl mx-auto">
      {zones.quartiers.map(quartier => (
        <div class="bg-accent-tertiary border border-white px-4 py-3 rounded-lg text-center shadow-sm hover:shadow-md transition-all duration-300">
          <span class="text-primary font-medium text-sm">
            {quartier}
          </span>
        </div>
      ))}
    </div>

    <!-- Practical Info -->
    <div class="bg-white rounded-[10px] shadow-custom2 p-8 max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="text-center">
          <h3 class="font-semibold text-primary mb-2">Temps de trajet</h3>
          <p class="text-secondary text-sm">{zones.praticalInfo.tempsTrajet}</p>
        </div>

        <div class="text-center">
          <h3 class="font-semibold text-primary mb-2">Rendez-vous</h3>
          <p class="text-secondary text-sm">{zones.praticalInfo.rdv}</p>
        </div>

        <div class="text-center">
          <h3 class="font-semibold text-primary mb-2">Devis</h3>
          <p class="text-secondary text-sm">{zones.praticalInfo.devis}</p>
        </div>
      </div>
    </div>
  </div>
</section>
