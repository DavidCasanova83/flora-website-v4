---
import "../styles/global.css";
import "../styles/swiper-bundle.min.css";
import { Image } from 'astro:assets';
import StructuredData from "../components/StructuredData.astro";


// Import des images
import logo from '../assets/img/header/logo.png';

// Définition des props
interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const { title, description, keywords = "architecte d'intérieur, décoration, aménagement, rénovation, Toulon, Var", ogImage = "/assets/img/header/logo.png", canonicalUrl = "https://www.flora-architecteinterieur.com" } = Astro.props;
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <link rel="icon" type="image/svg+xml" href="/favicon-32x32.svg">
    
    <!-- Balises meta essentielles -->
    <title>Flor'architecte - {title}</title>
    <meta name="description" content={description}>
    <meta name="keywords" content={keywords}>
    <meta name="author" content="Flor'architecte">
    <meta name="robots" content="index, follow">
    
    <!-- Balises Open Graph pour les réseaux sociaux -->
    <meta property="og:title" content={`Flor'architecte - ${title}`}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Flor'architecte">
    <meta property="og:locale" content="fr_FR">
    
    <!-- Balises Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={`Flor'architecte - ${title}`}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl}>


		<!-- Structured Data -->
		<StructuredData
			name="Flor'architecte	"
			url="https://www.flora-architecteinterieur.com"
			logo="https://www.flora-architecteinterieur.com/_astro/logo-transparent.D0W9nURY_1JNeax.webp"
			telephone="+33695584639"
			email="leicarragueflora@gmail.com"
			address={{
				street: "3 Impasse François Marcel",
				city: "Toulon",
				postalCode: "83000",
				country: "FR"
			}}
			geo={{
				lat: 43.1242,
				lng: 5.928
			}}
			socialLinks={[
				"https://www.instagram.com/florarchitecte/",
				"https://www.facebook.com/profile.php?id=100090151565975",
				"https://www.linkedin.com/in/flora-leicarrague-4a7baa205/"
			]}
		/>
    
    <!-- Autres liens et scripts -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.min.css">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@glidejs/glide/dist/css/glide.core.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@glidejs/glide/dist/css/glide.theme.min.css">
    <script src="https://cdn.jsdelivr.net/npm/@glidejs/glide/dist/glide.min.js" defer></script>
    <script src="/js/main.js" defer></script>
  </head>

  <body class="font-primary">

		<!-- header -->
		<header class="p-2">
					<!-- Menu à droite -->
					<div class="flex justify-center lg:justify-end">
						<nav class="hidden lg:flex lg:items-center lg:justify-center lg:px-[50px]">
							<!-- List Nav -->
							<ul class="flex gap-x-4 whitespace-nowrap">
								<li>
									<a href="/"
										class="pr-4 text-secondary hover:text-accent transition-all duration-300 uppercase">Accueil</a>
								</li>
								<li>
									<a href="/a-propos"
										class="pr-4 text-secondary hover:text-accent transition-all duration-300 uppercase">À propos</a>
								</li>
								<li>
									<a href="/prestations"
										class="pr-4 text-secondary hover:text-accent transition-all duration-300 uppercase">Prestations</a>
								</li>
								<li>
									<a href="/realisations"
										class="pr-4 text-secondary hover:text-accent transition-all duration-300 uppercase">Réalisations</a>
								</li>
								<li>
									<a href="/avis"
										class="pr-4 text-secondary hover:text-accent transition-all duration-300 uppercase">Avis & actualité</a>
								</li>
								<li>
									<a href="/contact"
										class="pr-4 text-secondary hover:text-accent transition-all duration-300 uppercase">Contact</a>
								</li>
							</ul>
						</nav>
						<!-- mobile nav -->
						<nav
							class="mnav fixed top-0 left-[-100%] w-64 h-full bg-white shadow-lg transition-all duration-300 ease-in-out z-30">
							<!-- nav trigger -->
							<div
								class="mnav__close-btn w-8 h-8 fixed top-4 right-4 flex justify-center items-center rounded-br-lg cursor-pointer transition-all lg:hidden">
								<i class="mnav__close-btn-icon ri-menu-line text-2xl text-black transition-transform duration-300"></i>
							</div>
							<div class="px-12 my-24 flex flex-col items-center text-left gap-y-12 h-full">
								<ul>
									<li><a href="/" class="text-secondary hover:text-accent transition-all duration-300">Accueil</a>
									</li>
									<li><a href="/a-propos" class="text-secondary hover:text-accent transition-all duration-300">À
											propos</a></li>
									<li><a href="/prestations"
											class="text-secondary hover:text-accent transition-all duration-300">Prestations</a></li>
									<li><a href="/realisations"
											class="text-secondary hover:text-accent transition-all duration-300">Réalisations</a></li>
									<li><a href="/avis" class="text-secondary hover:text-accent transition-all duration-300">Avis &
											actualité</a></li>
									<li><a href="/contact"
											class="text-secondary hover:text-accent transition-all duration-300">Contact</a></li>
								</ul>
							</div>
						</nav>
						<a href="tel:+33695584639"
							class="lg:hidden flex justify-center items-center border-2 px-4 py-2 border-accent rounded-xl transition-all duration-300 text-accent hover:text-white hover:border-accent hover:bg-accent focus:outline-none">
							<i class="ri-phone-fill text-2xl"></i>
						</a>
					</div>
				
		</header>
		<!-- header end -->

    <slot /> 
    
    <!-- footer -->
		<footer class="footer pt-12 xl:pt-[150px]">
			<div class="container mx-auto pb-12 xl:pb-[100px]">
				<!-- logo  -->
				<div class="max-w-[300px] flex justify-center mx-auto mb-[30px]">
					<a href="/">
						<Image
							src={logo}
							alt="Flor'architecte - Logo"
							class="mb-[30px]"
							width={300}
							height={100}
							loading="lazy"
						/>
					</a>
				</div>

				<!-- 2 colonnes  -->
				<div class="flex flex-col xl:flex-row gap-x-5 gap-y-10 ">
					<!-- footer contact section -->
					<div class="footer__item flex-1 flex flex-col items-center">
						<!-- text section -->
						<div class="mx-auto">
							<!-- description -->
							<p class="mb-[20px]">Flora LEICARRAGUE - Architecte d'intérieur & Maître d'œuvre</p>
							<!-- location email phone -->
							<div class="flex flex-col gap-y-3 mb-10">
								<div class="flex items-center gap-x-[6px]">
									<i class="ri-map-pin-fill text-[24px] text-accent"></i>
									<div>
										<a href="https://www.google.com/maps/place//data=!4m2!3m1!1s0x4e0e2a68f1a90c79:0x8249c7a822d6161d?sa=X&ved=1t:8290&ictx=111" target="_blank" class="hover:text-accent transition-all font-['Montserrat'] font-light">
											3 Imp. François Marcel, 83000 Toulon
										</a>
									</div>
								</div>
								<div class="flex items-center gap-x-[6px]">
									<i class="ri-mail-fill text-[24px] text-accent"></i>
									<div>
										<a href="/contact" class="hover:text-accent transition-all font-['Montserrat'] font-light">
											leicarragueflora@gmail.com
										</a>
									</div>
								</div>
								<div class="flex items-center gap-x-[6px]">
									<i class="ri-phone-fill text-[24px] text-accent"></i>
									<div>
										<a href="tel:+33695584639" class="hover:text-accent transition-all font-['Montserrat'] font-light">
											06 95 58 46 39
										</a>
									</div>
								</div>
								<div class="flex items-center gap-x-[6px]">
									<i class="ri-google-fill text-[24px] text-accent"></i>
									<div>
										<a href="https://g.co/kgs/gBdYzP1" target="_blank" class="hover:text-accent transition-all font-['Montserrat'] font-light">
											Voir notre fiche Google
										</a>
									</div>
								</div>
							</div>
						</div>
	
					</div>
					<!-- footer hours  -->
					<div class="footer__item flex-1">
						<p class="mb-4">Disponibilités</p>
						<!-- list   -->
						<div class="flex flex-col gap-5">
							<!--  item  -->
							<div class="flex-1">
								<div class="flex justify-between items-center border-b pb-[10px]">
									<div>Lundi au Vendredi</div>
									<div class="text-accent font-medium font-['Montserrat']">9h00 - 19h00</div>
								</div>
							</div>
							<!--  item 2 -->
							<div class="flex-1">
								<div class="flex justify-between items-center border-b pb-[10px]">
									<div>Samedi</div>
									<div class="text-accent font-medium">Fermé</div>
								</div>
							</div>
							<!--  item 3 -->
							<div class="flex-1">
								<div class="flex justify-between items-center lg:border-b pb-[10px]">
									<div>Dimanche et jours fériés</div>
									<div class="text-accent font-medium">Fermé</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- social -->
				<div class="flex justify-center items-center gap-[14px] text-[30px] my-12">
					<div
						class="p-[10px] rounded-[10px] shadow-custom2 text-accent-tertiary hover:text-accent cursor-pointer transition-all">
						<a href="https://www.instagram.com/florarchitecte/"><i class="ri-instagram-fill"></i></a>
					</div>
					<div
						class="p-[10px] rounded-[10px] shadow-custom2 text-accent-tertiary hover:text-accent cursor-pointer transition-all">
						<a href="https://www.facebook.com/profile.php?id=100090151565975"><i
								class="ri-facebook-circle-fill"></i></a>
					</div>
					<div
						class="p-[10px] rounded-[10px] shadow-custom2 text-accent-tertiary hover:text-accent cursor-pointer transition-all">
						<a href="https://www.linkedin.com/in/flora-leicarrague-4a7baa205/"><i
								class="ri-linkedin-box-fill"></i></a>
					</div>
				</div>

				<!-- 1 colonne  -->
				<div class="flex flex-col xl:flex-row border-t pt-[50px] mt-[30px]">
					<!-- footer link section -->
					<div class="footer__item flex-1">
						<div class="flex justify-center items-center">
							<!-- Wrapper pour centrer -->
							<div class="flex flex-wrap justify-center gap-x-8 gap-y-4 text-left">
								<!-- list 1   -->
								<a href="/" class="hover:text-accent transition-all">Accueil</a>
								<a href="/prestations" class="hover:text-accent transition-all">Prestations</a>
								<a href="/realisations" class="hover:text-accent transition-all">Réalisations</a>
								<a href="/avis" class="hover:text-accent transition-all">Avis</a>
								<a href="/contact" class="hover:text-accent transition-all">Contact</a>
								<a href="/a-propos" class="hover:text-accent transition-all">À propos</a>
								<a href="/faq" class="hover:text-accent transition-all">FAQ</a>
								<a href="/actualite" class="hover:text-accent transition-all">Actualité</a>
							</div>
						</div>
					</div>
				</div>
			</div>
			<!-- copyright -->
			<div class="py-[30px] border-t">
				<div class="container mx-auto text-left">
					<div class="font-light text-base">&copy; 2025 Flor'architecte - Tous droit réservé</div>
				</div>
			</div>
		</footer>
		<!-- footer end -->
	
		<!-- SCRIPTS -->
		<!-- swiper js -->
		<script>
			// Charge Swiper, puis ScrollReveal, puis main.js
			const scriptSwiper = document.createElement('script');
			scriptSwiper.src = '/js/swiper-bundle.min.js';
			scriptSwiper.onload = () => {
				const scriptScroll = document.createElement('script');
				scriptScroll.src = '/js/scrolreveal.min.js';
				scriptScroll.onload = () => {
					const scriptMain = document.createElement('script');
					scriptMain.src = '/js/main.js';
					document.body.appendChild(scriptMain);
				};
				document.body.appendChild(scriptScroll);
			};
			document.body.appendChild(scriptSwiper);
		</script>		
  </body>


</html>