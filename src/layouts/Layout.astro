---
import "../styles/global.css";
import "../styles/swiper-bundle.min.css";
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/favicon-32x32.png">
    <title>Flor'architecte - {Astro.props.title}</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.min.css">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

  </head>

  <body class="font-primary">

		<!-- header -->
		<header class="p-2">
					<!-- Menu à droite -->
					<div class="flex justify-center lg:justify-end">
						<nav class="hidden lg:flex lg:items-center lg:justify-center lg:px-[50px]">
							<!-- List Nav -->
							<ul class="flex gap-x-4 whitespace-nowrap">
								<li>
									<a href="/"
										class="pr-4 text-secondary hover:text-accent transition-all duration-300 uppercase">Accueil</a>
								</li>
								<li>
									<a href="a-propos"
										class="pr-4 text-secondary hover:text-accent transition-all duration-300 uppercase">Qui suis-je</a>
								</li>
								<li>
									<a href="prestations"
										class="pr-4 text-secondary hover:text-accent transition-all duration-300 uppercase">Prestations</a>
								</li>
								<li>
									<a href="realisations"
										class="pr-4 text-secondary hover:text-accent transition-all duration-300 uppercase">Réalisations</a>
								</li>
								<li>
									<a href="avis"
										class="pr-4 text-secondary hover:text-accent transition-all duration-300 uppercase">Avis & actualité</a>
								</li>
								<li>
									<a href="contact"
										class="pr-4 text-secondary hover:text-accent transition-all duration-300 uppercase">Contact</a>
								</li>
							</ul>
						</nav>
						<!-- mobile nav -->
						<nav
							class="mnav fixed top-0 left-[-100%] w-64 h-full bg-white shadow-lg transition-all duration-300 ease-in-out z-30">
							<!-- nav trigger -->
							<div
								class="mnav__close-btn w-8 h-8 fixed top-4 right-4 flex justify-center items-center rounded-br-lg cursor-pointer transition-all lg:hidden">
								<i class="mnav__close-btn-icon ri-menu-line text-2xl text-black transition-transform duration-300"></i>
							</div>
							<div class="px-12 my-24 flex flex-col items-center text-center gap-y-12 h-full">
								<ul>
									<li><a href="index.html" class="text-secondary hover:text-accent transition-all duration-300">Accueil</a>
									</li>
									<li><a href="about.html" class="text-secondary hover:text-accent transition-all duration-300">Qui
											suis-je</a></li>
									<li><a href="prestations.html"
											class="text-secondary hover:text-accent transition-all duration-300">Prestations</a></li>
									<li><a href="realisations.html"
											class="text-secondary hover:text-accent transition-all duration-300">Réalisations</a></li>
									<li><a href="avis.html" class="text-secondary hover:text-accent transition-all duration-300">Avis &
											actualité</a></li>
									<li><a href="contact.html"
											class="text-secondary hover:text-accent transition-all duration-300">Contact</a></li>
								</ul>
							</div>
						</nav>
						<a href="tel:+33695584639"
							class="lg:hidden flex justify-center items-center border-2 px-4 py-2 border-accent rounded-xl transition-all duration-300 text-accent hover:text-white hover:border-accent hover:bg-accent focus:outline-none">
							<i class="ri-phone-fill text-2xl"></i>
						</a>
					</div>
				
		</header>
		<!-- header end -->

    <slot /> 
    
    <!-- footer -->
		<footer class="footer pt-12 xl:pt-[150px]">
			<div class="container mx-auto pb-12 xl:pb-[100px]">
				<!-- logo  -->
				<div class="max-w-[300px] flex justify-center mx-auto mb-[30px]">
					<a href="./index.html">
						<img class="mb-[30px]" src="./assets/img/header/logo.png" alt="">
					</a>
				</div>

				<!-- 2 colonnes  -->
				<div class="flex flex-col xl:flex-row gap-x-5 gap-y-10 ">
					<!-- footer contact section -->
					<div class="footer__item flex-1 flex flex-col items-center">
						<!-- text section -->
						<div class="mx-auto">
							<!-- description -->
							<p class="mb-[20px]">Flora LEICARRAGUE - Architecte d'intérieur</p>
							<!-- location email phone -->
							<div class="flex flex-col gap-y-3 mb-10">
								<div class="flex items-center gap-x-[6px]">
									<i class="ri-map-pin-fill text-[24px] text-accent"></i>
									<div>
										Toulon(83100) - France
									</div>
								</div>
								<div class="flex items-center gap-x-[6px]">
									<i class="ri-mail-fill text-[24px] text-accent"></i>
									<div>
										leicarragueflora@gmail.com</div>
								</div>
								<div class="flex items-center gap-x-[6px]">
									<i class="ri-phone-fill text-[24px] text-accent"></i>
									<div>
										06 95 58 46 39</div>
								</div>
							</div>
							<!-- social -->
							<div class="flex gap-[14px] text-[30px]">
								<div
									class="p-[10px] rounded-[10px] shadow-custom2 text-accent-tertiary hover:text-accent cursor-pointer transition-all">
									<a href="https://www.instagram.com/florarchitecte/"><i class="ri-instagram-fill"></i></a>
	
								</div>
								<div
									class="p-[10px] rounded-[10px] shadow-custom2 text-accent-tertiary hover:text-accent cursor-pointer transition-all">
									<a href="https://www.facebook.com/profile.php?id=100090151565975"><i
											class="ri-facebook-circle-fill"></i></a>
								</div>
								<div
									class="p-[10px] rounded-[10px] shadow-custom2 text-accent-tertiary hover:text-accent cursor-pointer transition-all">
									<a href="https://www.linkedin.com/in/flora-leicarrague-4a7baa205/"><i
											class="ri-facebook-circle-fill"></i></a>
								</div>
							</div>
						</div>
	
					</div>
					<!-- footer hours  -->
					<div class="footer__item flex-1">
						<h4>Disponibilités</h4>
						<!-- list   -->
						<div class="flex flex-col gap-5">
							<!--  item  -->
							<div class="flex-1">
								<div class="flex justify-between items-center border-b pb-[10px]">
									<div>Lundi au Vendredi </div>
									<div class="text-accent font-medium">8h30 - 18h00</div>
								</div>
							</div>
							<!--  item 2 -->
							<div class="flex-1">
								<div class="flex justify-between items-center border-b pb-[10px]">
									<div>Samedi</div>
									<div class="text-accent font-medium">8h30 - 12h00 </div>
								</div>
							</div>
							<!--  item 3 -->
							<div class="flex-1">
								<div class="flex justify-between items-center lg:border-b pb-[10px]">
									<div>Dimanche et jours fériés </div>
									<div class="text-accent font-medium">Indisponible</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- 1 colonne  -->
				<div class="flex flex-col xl:flex-row border-t pt-[50px] mt-[30px]">
					<!-- footer link section -->
					<div class="footer__item flex-1">
						<div class="flex justify-center items-center">
							<!-- Wrapper pour centrer -->
							<div class="flex flex-col sm:flex-row gap-x-10 gap-y-10 text-center">
								<!-- list 1   -->
								<ul class="flex-1 flex flex-col gap-y-5">
									<li><a href="./index.html" class="hover:text-accent transition-all">Accueil</a></li>
									<li><a href="./prestations.html" class="hover:text-accent transition-all">Prestations</a></li>
									<li><a href="./réalisations" class="hover:text-accent transition-all">Réalisations</a></li>
									<li><a href="./avis" class="hover:text-accent transition-all">Avis</a></li>
								</ul>
								<!-- list 2   -->
								<ul class="flex-1 flex flex-col gap-y-5">
									<li><a href="./contact.html" class="hover:text-accent transition-all">Contact</a></li>
									<li><a href="./about.html" class="hover:text-accent transition-all">Qui suis-je</a></li>
									<li><a href="./faq.html" class="hover:text-accent transition-all">FAQ</a></li>
									<li><a href="./actualité" class="hover:text-accent transition-all">Actualité</a></li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			</div>
			<!-- copyright -->
			<div class="py-[30px] border-t">
				<div class="container mx-auto text-center">
					<div class="font-light text-base">&copy; 2025 Flor'architecte - Tous droit réservé</div>
				</div>
			</div>
		</footer>
		<!-- footer end -->
	
		<!-- SCRIPTS -->
		<!-- swiper js -->
		<script is:inline>
      const scripts = [
			'js/swiper-bundle.min.js',
      'js/scrolreveal.min.js',
      'js/main.js',
      ];

      scripts.forEach(src => {
        const script = document.createElement('script');
        script.src = src;
        script.defer = true;
        document.body.appendChild(script);
      });
    </script>
  </body>


</html>