---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";

---

<Layout title="Avis & actualité" description="Découvrez les avis de mes clients et l'actualité concernant l'architecture d'intérieur.">

  <!-- hero -->
  <section class="heropy-12 mb-12 xl:pt-12 xl:pb-0 overflow-hidden">
    <div class="container mx-auto h-full flex flex-col justify-center items-center xl:px-24">
      <h1 class="h1 mb-6">Vos avis</h1>
      <p class="mb-[16px] md:max-w-xl text-justify">
        Découvrez les avis de clients pour lesquels j'ai réalisé des projets de rénovation & de décoration.
      </p>
    </div>
  </section>
  <!-- hero end -->

  <!-- avis list 01 -->
  <section class="blog">
    <div class="container mx-auto">
      <!-- blog post  -->
      <div class="flex flex-col xl:flex-row gap-y-6 xl:gap-y-0 xl:gap-x-6 items-center xl:justify-between mb-[50px]">
        <!-- post 1 -->
        <div class="blog__post max-w-[420px] shadow-custom2 rounded-[10px] overflow-hidden cursor-pointer group">
          <div class="relative overflow-hidden h-[480px]">
            <img class="group-hover:scale-125 transition-all duration-500 object-cover scale-110"
              src="./assets/img/AVIS/avis01.png" alt="">
          </div>
        </div>
        <!-- post 2 -->
        <div class="blog__post max-w-[420px] shadow-custom2 rounded-[10px] overflow-hidden cursor-pointer group">
          <div class="relative overflow-hidden h-[480px]">
            <img class="group-hover:scale-125 transition-all duration-500 object-cover scale-110"
              src="./assets/img/AVIS/avis02.png" alt="">
          </div>
        </div>
        <!-- post 3 -->
