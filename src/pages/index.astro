---
import Layout from '../layouts/Layout.astro';
import LastProjects from '../components/LastProjects.astro';
import avis from '../data/avis.json';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout title="Architecte d'intérieur Toulon" description="Architecte d'intérieur, décoration et aménagement, nous vous accompagnons dans vos projets de rénovation et d'aménagement avec une prestation clé en main.">
	<!-- Section Hero avec slider en fond et texte fixe -->
	<section class="relative h-screen overflow-hidden">
		<!-- Slider en fond (positionné en absolu pour occuper tout le container) -->
		<div class="absolute inset-0 z-0">
			<div class="swiper slider-bg">
				<div class="swiper-wrapper">
					<!-- Slide 1 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/header-web-site-flora-opti.jpg" alt="image-deco-header-website" class="w-full h-screen object-cover">
					</div>
					<!-- Ajoute autant de slides que nécessaire -->
				</div>
				<!-- Pagination du slider -->
				<div class="swiper-pagination"></div>
			</div>
		</div>

		<!-- Texte Hero en overlay (positionné en relatif pour se placer au-dessus du slider) -->
		<div class="relative z-10 flex items-center justify-center md:justify-start h-full px-4 lg:mx-24 md:px-8 py-12">
			<div class="bg-white bg-opacity-90 rounded-md text-left text-primary p-6 md:p-12 max-w-2xl w-full">
				<!-- logo  -->
				<div class="max-w-[300px] flex flex-col justify-end items-end mb-[30px]">
					<a href="./index.html">
						<img class="mb-[30px]" src="./assets/img/header/logo-transparent.png" alt="">
					</a>
				</div>					
				<h1 class="text-2xl sm:text-3xl md:text-4xl font-light mb-4 text-primary">
					Architecte d'intérieur<br/> & Maître d'œuvre sur TOULON
				</h1>
				<p class="mb-[42px] md:max-w-xl text-left">Basée à Toulon et certifié au CFAI (Conseil Français des Architectes d'intérieur), l'agence Flor'A vous accompagne dans vos projets de rénovation et d'aménagement intérieurs et extérieurs.

					Soucieuse d'une architecture responsable et du bien-être de ses occupants, nous mettons notre sensibilité, notre savoir-faire et notre expertise à votre service afin de vous proposer un projet qui vous ressemble et qui soit en adéquation avec votre budget et votre mode de vie.
					
					Nous vous accompagnons ainsi de la première esquisse jusqu'au suivi de chantier, vous proposant un projet clé en main.
				</p>
				<div class="flex flex-col sm:flex-row gap-4">
					<a href="./contact.html" class="btn btn-lg btn-accent w-full sm:w-auto text-center">Contactez-nous</a>
				</div>
			</div>
		</div>
		
	</section>
	<!-- Section Hero avec slider en fond et texte fixe -->



	<!-- services -->
	<section class="services my-7">
		<!-- bg description -->
		<div
			class="bg-services bg-cover bg-no-repeat max-w-[1466px] mx-4 xl:mx-auto rounded-[10px] xl:pt-[70px] px-6 xl:px-0 relative h-[368px] flex items-center xl:items-start -z-10">
			<div class="container mx-auto">
				<div class="services__top flex items-center flex-col xl:flex-col xl:mb-[60px]">
					<h2 class="h2 text-white flex-1 mb-4 xl:mb-0 texte-center xl:text-left">Flor'A - un m² bien pensé en vaut
						<span class="text-4xl align-middle">2</span> !
					</h2>
					<p class="text-white flex-1 text-center xl:text-left max-w-2xl xl:max-w-none">Une agence qui met le bâti au service de ses occupants.
					</p>
				</div>
			</div>
		</div>
		<div class="container mx-auto mt-8 xl:-mt-[144px]">
			<div class="grid xl:grid-cols-4 gap-5 px-8 xl:px-0">
				<!-- bloque 1 -->
				<div
					class="services__item bg-white p-[30px] rounded-[10px] shadow-custom2 min-h-[200px] flex flex-col justify-between">
					<div class="text-center">
						<h3 class="h3 mb-[10px]">Conception</h3>
						<p class="font-light leading-normal max-w-[300px] mx-auto">
							De la découverte du lieu à l'étude du projet en plan et en 3D avec rendu réaliste</p>
					</div>
					<a class="text-accent underline text-center" href="./prestations#etape1">Étape 1</a>
				</div>
				<!-- bloque 2 -->
				<div
					class="services__item bg-white p-[30px] rounded-[10px] shadow-custom2 min-h-[200px] flex flex-col justify-between">
					<div class="text-center">
						<h3 class="h3 mb-[10px]">Démarches administratives</h3>
						<p class="font-light leading-normal max-w-[300px] mx-auto">
							Accompagnement dans les autorisations d'urbanisme et les consultation des entreprises/des fournisseurs.</p>
					</div>
					<a class="text-accent underline text-center" href="./prestations#etape2">Étape 2</a>
				</div>
				<!-- bloque 3 -->
				<div
					class="services__item bg-white p-[30px] rounded-[10px] shadow-custom2 min-h-[200px] flex flex-col justify-between">
					<div class="text-center">
						<h3 class="h3 mb-[10px]">Suivi de chantier</h3>
						<p class="font-light leading-normal max-w-[300px] mx-auto">
							Coordination des artisans, réunion de chantier hebdomadaires et réception des travaux.</p>
					</div>
					<a class="text-accent underline text-center" href="./prestations#etape3">Étape 3</a>
				</div>
				<!-- bloque 4 -->
				<div
					class="services__item bg-white p-[30px] rounded-[10px] shadow-custom2 min-h-[200px] flex flex-col justify-between">
					<div class="text-center">
						<h3 class="h3 mb-[10px]">Aménagement</h3>
						<p class="font-light leading-normal max-w-[300px] mx-auto">
							Proposition de mobilier et d'éléments de décoration, dessin de mobilier sur mesure.
						</p>
					</div>
					<a class="text-accent underline text-center" href="./prestations#etape4">Étape 4</a>
				</div>
			</div>
		</div>
	</section>
	<!-- services end -->


	<!-- slide photo -->
	<section class="photo-slider testimonial pb-[150px] xl:min-h-[800px] xl:py-0 mt-7">
		<div class="mx-auto xl:container">
			<!-- slider -->
			<div class="photo-slider swiper min-h-[650px]">
				<!-- Additional required wrapper -->
				<div class="swiper-wrapper slider__photo">
					<!-- Slide 1 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide01.png.avif" alt="Photo 1" class="w-full h-[600px] object-cover">
					</div>
					<!-- Slide 2 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide02.png.avif" alt="Photo 2" class="w-full h-[600px] object-cover">
					</div>
					<!-- Slide 3 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide03.avif" alt="Photo 3" class="w-full h-[600px] object-cover">
					</div>
					<!-- Slide 4 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide04.avif" alt="Photo 3" class="w-full h-[600px] object-cover">
					</div>
					<!-- Slide 5 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide05.avif" alt="Photo 3" class="w-full h-[600px] object-cover">
					</div>
					<!-- Slide 6 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide06.avif" alt="Photo 3" class="w-full h-[600px] object-cover">
					</div>
					<!-- Slide 7 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide07.avif" alt="Photo 3" class="w-full h-[600px] object-cover">
					</div>
					<!-- Slide 8 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide08.avif" alt="Photo 3" class="w-full h-[600px] object-cover">
					</div>
					<!-- Slide 9 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide09.avif" alt="Photo 3" class="w-full h-[600px] object-cover">
					</div>
				</div>
				<!-- Swiper pagination -->
				<div class="swiper-pagination"></div>
			</div>
		</div>
	</section>
	<!-- slide photo end -->

	<LastProjects />

	<!-- testimonials -->
	<section class="testimonial bg-testimonials bg-cover bg-right bg-no-repeat p-12 my-24">
		<div class="testimonial__container container mx-auto">
			<div class="flex flex-col items-center">
				<h2 class="h2 text-white text-center my-8">Vos avis comptent et nous vous en remercions</h2>
				<!-- slider -->
				<div class="w-full max-w-[710px]">
					<!-- Slider main container -->
					<div class="swiper testimonial-swiper h-[400px]">
						<!-- Additional required wrapper -->
						<div class="swiper-wrapper">
							{avis.avis.map((avis) => (
								<div class="swiper-slide">
									<div class="h-full flex flex-col justify-center items-center">
										<div class="max-w-[680px] mx-auto text-center">
											<!-- Google Logo -->
											<div class="flex justify-center mb-6">
												<img src="/assets/img/testimonials/avis-google.avif" alt="Google" class="h-12 w-auto" />
											</div>
											<!-- Message -->
											<p
												class="font-light relative text-[18px] text-[#4c5345] leading-[198%] text-center before:bg-quoteLeft before:bg-contain before:bg-bottom before:inline-block before:top-0 before:w-10 before:h-10 before:bg-no-repeat
													after:bg-quoteRight after:bg-contain after:bg-bottom after:inline-block after:top-0 after:w-10 after:h-10 after:bg-no-repeat">
												<span class="mx-2">{avis.message}</span>
											</p>
											<!-- Name -->
											<div class="text-[22px] text-[#4c5354] font-semibold mt-6">
												{avis.nom}
											</div>
											<div class="text-white font-medium uppercase tracking-[2.24px]">{avis.type}</div>
										</div>
									</div>
								</div>
							))}
						</div>
						<!-- Swipper pagination -->
						<div class="swiper-pagination"></div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- testimonials end -->


	<!-- contact panel -->
	<section class="newsletter bg-accent md:h-[444px] py-12 mx-2 lg:mx-24 rounded-[10px] flex items-center justify-center relative overflow-hidden">
		<!-- container -->
		<div class="newsletter__container container mx-auto">
			<!-- wrapper -->
			<div class="flex flex-col lg:flex-row lg:items-center lg:justify-center lg:gap-x-[58px] max-w-4xl mx-auto">
				<!-- text -->
				<div class="flex-1 z-10 text-center">
					<div class="text-base uppercase text-white tracking-[2.24px] font-medium">Une question, un projet ?</div>
					<h2 class=" mb-4 text-3xl text-left text-white">Nous serons ravis de pouvoir vous rencontrer et de répondre à vos envies.</h2>
				</div>
				<!-- form -->
				<div class="flex-1 flex justify-center">
					<div class="flex flex-col md:flex-row relative gap-y-4">
						<a href="./contact.html" class="btn btn-lg btn-white">Contactez-nous</a>
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- contact panel end-->



</Layout>
