---
import Layout from '../layouts/Layout.astro';
import LastProjects from '../components/LastProjects.astro';
import avis from '../data/avis.json';
import { Image, Picture } from 'astro:assets';
import headerImage from '../assets/img/sliderphoto/header-site-web-flora-architecte.jpg';
import headerMobile from "../assets/img/sliderphoto/header-site-web-flora-architecte-mobile.jpg";
import slide01 from '../assets/img/sliderphoto/slide01.jpeg';
import slide02 from '../assets/img/sliderphoto/slide02.jpeg';
import slide03 from '../assets/img/sliderphoto/slide03.jpeg';
import slide04 from '../assets/img/sliderphoto/slide04.jpg';
import slide05 from '../assets/img/sliderphoto/slide05.jpg';
import slide06 from '../assets/img/sliderphoto/slide06.jpg';
import slide07 from '../assets/img/sliderphoto/slide07.jpg';
import slide08 from '../assets/img/sliderphoto/slide08.jpg';
import slide09 from '../assets/img/sliderphoto/slide09.jpg';
import slide10 from '../assets/img/sliderphoto/slide10.jpg';
import logoTransparent from '../assets/img/header/logo-transparent.png';
import avisGoogle from '../assets/img/testimonials/avis-google.avif';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout title="Architecte d'intérieur et maître d'œuvre sur Toulon" description="Décoration et aménagement, nous vous accompagnons dans vos projets de rénovation et d'aménagement avec une prestation clé en main.">
	<!-- Section Hero avec image de fond fixe -->
	<section class="relative overflow-hidden bg-mobile">
		<!-- Image de fond -->
		<div class="absolute inset-0 z-0">
			<Picture
				src={headerImage}
				alt="Rénovation d'un salon moderne par Flor'Architecte à Toulon"
				formats={['avif', 'webp']}
				loading="eager"
				sizes="(max-width: 768px) 100vw, 1920px"
				class="hidden md:block w-full h-screen object-cover"
			/>
		</div>
		<!-- Texte Hero en overlay -->
		<div class="relative z-10 flex items-center justify-center md:justify-start min-h-[600px] sm:min-h-[700px] lg:min-h-[800px] px-4 sm:px-6 md:px-8 py-8 sm:py-12">
			<div class="bg-white bg-opacity-90 rounded-md text-left text-primary p-4 sm:p-6 md:p-12 max-w-[680px] w-full mx-auto md:mx-0 md:ml-24 shadow-md">
				<!-- Logo -->
				<div class="w-[180px] sm:w-[220px] md:w-[280px] mx-auto sm:mx-0 flex justify-end items-end mb-6 sm:mb-[30px]">
					<a href="/">
						<Image
							src={logoTransparent}
							alt="Logo officiel de Flor'Architecte, architecte d'intérieur à Toulon"
							class="w-full h-auto mb-4 sm:mb-[30px]"
							width={400}
							height={136}
							decoding="async"
							loading="lazy"
						/>
					</a>
				</div>
				<h1 class="text-xl sm:text-2xl md:text-4xl font-light mb-3 sm:mb-4 text-primary leading-tight">
					Architecte d'intérieur<br class="hidden sm:block" /> & Maître d'œuvre sur TOULON
				</h1>
				<p class="mb-6 sm:mb-[42px] text-sm sm:text-base text-left leading-relaxed">
					Flor'A, agence d'architecture d'intérieur certifiée CFAI à Toulon, vous accompagne dans vos projets de rénovation et d'aménagement, intérieurs comme extérieurs.
					<br /><br />
					Nous concevons des espaces sur mesure, en accord avec votre style, votre budget et votre mode de vie. Sensibles à une architecture responsable et au bien-être des occupants, nous vous guidons de la première esquisse jusqu'au suivi de chantier, pour un projet clé en main.
				</p>
				<div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
					<a href="contact" class="btn btn-lg btn-accent w-full sm:w-auto text-left">Contactez-nous</a>
				</div>
			</div>
		</div>		
	</section>
	<!-- Section Hero avec slider en fond et texte fixe -->

	<!-- services -->
	<section class="services my-10 xl:my-20">
		<!-- bg description -->
		<div
			class="bg-services bg-cover bg-no-repeat max-w-[1466px] mx-4 xl:mx-auto rounded-[10px] xl:pt-[70px] px-6 xl:px-0 relative h-[368px] flex items-center xl:items-start -z-10">
			<div class="container mx-auto">
				<div class="services__top flex items-center flex-col xl:flex-col xl:mb-[60px]">
					<h2 class="text-3xl text-white flex-1 mb-4 xl:mb-0 text-left">
						Flor'A - Un m² bien pensé en vaut 2 !
					</h2>					
					<p class="text-white flex-1 text-left max-w-2xl xl:max-w-none">Une agence qui met le bâti au service de ses occupants.
					</p>
				</div>
			</div>
		</div>
		<div class="container mx-auto mt-8 xl:-mt-[144px]">
			<div class="grid xl:grid-cols-4 gap-6 px-8 xl:px-0">
				<!-- bloque 1 -->
				<a href="./prestations#etape1"
					class="services__item bg-white p-[30px] rounded-[10px] shadow-custom2 min-h-[200px] flex flex-col justify-between transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
					<div class="text-left">
						<h3 class="h3 mb-[10px]">Conception</h3>
						<p class="font-light leading-normal max-w-[300px] mx-auto">
							De la découverte du lieu à l'étude du projet en plan et en 3D avec rendu réaliste</p>
					</div>
					<span class="text-accent underline text-left">Étape 1</span>
				</a>
				<!-- bloque 2 -->
				<a href="./prestations#etape2"
					class="services__item bg-white p-[30px] rounded-[10px] shadow-custom2 min-h-[200px] flex flex-col justify-between transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
					<div class="text-left">
						<h3 class="h3 mb-[10px]">Démarches administratives</h3>
						<p class="font-light leading-normal max-w-[300px] mx-auto">
							Accompagnement dans les autorisations d'urbanisme et les consultation des entreprises/des fournisseurs.</p>
					</div>
					<span class="text-accent underline text-left">Étape 2</span>
				</a>
				<!-- bloque 3 -->
				<a href="./prestations#etape3"
					class="services__item bg-white p-[30px] rounded-[10px] shadow-custom2 min-h-[200px] flex flex-col justify-between transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
					<div class="text-left">
						<h3 class="h3 mb-[10px] whitespace-nowrap">Suivi de chantier</h3>
						<p class="font-light leading-normal max-w-[300px] mx-auto">
							Coordination des artisans, réunion de chantier hebdomadaires et réception des travaux.</p>
					</div>
					<span class="text-accent underline text-left">Étape 3</span>
				</a>
				<!-- bloque 4 -->
				<a href="./prestations#etape4"
					class="services__item bg-white p-[30px] rounded-[10px] shadow-custom2 min-h-[200px] flex flex-col justify-between transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
					<div class="text-left">
						<h3 class="h3 mb-[10px]">Aménagement</h3>
						<p class="font-light leading-normal max-w-[300px] mx-auto">
							Proposition de mobilier et d'éléments de décoration, dessin de mobilier sur mesure.
						</p>
					</div>
					<span class="text-accent underline text-left">Étape 4</span>
				</a>
			</div>
		</div>
	</section>
	<!-- services end -->


	<!-- slide photo -->
	<section class="photo-slider testimonial xl:min-h-[800px] my-10 xl:py-0">
		<div class="mx-auto xl:container">
			<!-- slider -->
			<div class="photo-slider swiper min-h-[650px]">
				<!-- Additional required wrapper -->
				<div class="swiper-wrapper slider__photo">
					<!-- Slide 1 -->
					<div class="swiper-slide">
						<Picture
							src={slide01}
							loading="lazy"
							alt="Vue d'une cuisine contemporaine – réalisation Flor'Architecte à Toulon"
							formats={['avif', 'webp']}
							width={1250}
							height={600}
							quality={60}
							sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1250px"
							decoding="async"
							class="w-full h-[600px] object-cover"
						/>
					</div>
					<!-- Slide 2 -->
					<div class="swiper-slide">
						<Picture
							src={slide02}
							loading="lazy"
							alt="Salle de bain design avec matériaux naturels à Toulon"
							formats={['avif', 'webp']}
							width={1250}
							height={600}
							quality={60}
							sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1250px"
							decoding="async"
							class="w-full h-[600px] object-cover"
						/>
					</div>
					<!-- Slide 3 -->
					<div class="swiper-slide">
						<Picture
							src={slide03}
							loading="lazy"
							alt="Salon lumineux au mobilier sur mesure par Flor'Architecte"
							formats={['avif', 'webp']}
							width={1250}
							height={600}
							quality={60}
							sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1250px"
							decoding="async"
							class="w-full h-[600px] object-cover"
						/>
					</div>
					<!-- Slide 4 -->
					<div class="swiper-slide">
						<Picture
							src={slide04}
							loading="lazy"
							alt="Espace de vie rénové avec rangements intégrés"
							formats={['avif', 'webp']}
							width={1250}
							height={600}
							quality={60}
							sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1250px"
							decoding="async"
							class="w-full h-[600px] object-cover"
						/>
					</div>
					<!-- Slide 5 -->
					<div class="swiper-slide">
						<Picture
							src={slide05}
							loading="lazy"
								alt="Chambre moderne et fonctionnelle rénovée à Toulon"
							formats={['avif', 'webp']}
							width={1250}
							height={600}
							quality={70}
							sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1250px"
							decoding="async"
							class="w-full h-[600px] object-cover"
						/>
					</div>
					<!-- Slide 6 -->
					<div class="swiper-slide">
						<Picture
							src={slide06}
							loading="lazy"
							alt="Salle à manger avec verrière intérieure"
							formats={['avif', 'webp']}
							width={1250}
							height={600}
							quality={60}
							sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1250px"
							decoding="async"
							class="w-full h-[600px] object-cover"
						/>
					</div>
					<!-- Slide 7 -->
					<div class="swiper-slide">
						<Picture
							src={slide07}
							loading="lazy"
							alt="Coin lecture sous escalier optimisé"
							formats={['avif', 'webp']}
							width={1250}
							height={600}
							quality={60}
							sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1250px"
							decoding="async"
							class="w-full h-[600px] object-cover"
						/>
					</div>
					<!-- Slide 8 -->
					<div class="swiper-slide">
						<Picture
							src={slide08}
							loading="lazy"
							alt="Dressing sur mesure pour espace restreint"
							formats={['avif', 'webp']}
							width={1250}
							height={600}
							quality={60}
							sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1250px"
							decoding="async"
							class="w-full h-[600px] object-cover"
						/>
					</div>
					<!-- Slide 9 -->
					<div class="swiper-slide">
						<Picture
							src={slide09}
							loading="lazy"
							alt="Bureau aménagé dans un style épuré"
							formats={['avif', 'webp']}
							width={1250}
							height={600}
							quality={60}
							sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1250px"
							decoding="async"
							class="w-full h-[600px] object-cover"
						/>
					</div>
					<!-- Slide 10 -->
					<div class="swiper-slide">
						<Picture
							src={slide10}
							loading="lazy"
							alt="Bureau aménagé dans un style épuré architecture d'intérieur à Toulon"
							formats={['avif', 'webp']}
							width={1250}
							height={600}
							quality={60}
							sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1250px"
							decoding="async"
							class="w-full h-[600px] object-cover"
						/>
					</div>
				</div>
				<!-- Swiper pagination -->
				<div class="swiper-pagination"></div>
			</div>
		</div>
	</section>
	<!-- slide photo end -->

	<LastProjects  />

<!-- testimonials -->
<section class="testimonial bg-testimonials bg-cover bg-right bg-no-repeat p-8 sm:p-8 md:p-12 my-10 xl:my-20">
  <div class="testimonial__container container mx-auto">
    <div class="flex flex-col items-center">
      <h2 class="h2 text-white text-left my-4 sm:my-6 md:my-8 text-2xl sm:text-3xl md:text-4xl">
        Vos avis comptent et nous vous en remercions
      </h2>
      <!-- Glide slider -->
      <div class="w-full max-w-[710px] px-4 sm:px-0">
        <div class="glide" id="testimonial-slider">
          <div class="glide__track" data-glide-el="track">
            <ul class="glide__slides">
              {avis.avis.map((avis) => (
                <li class="glide__slide">
                  <div class="h-full flex flex-col justify-center items-center py-8">
                    <div class="max-w-[680px] mx-auto text-left px-4">
                      <!-- Google Logo -->
                      <div class="flex justify-center mb-4 sm:mb-6">
                        <Image
                          src={avisGoogle}
                          alt="Logo Google – avis clients Flor'Architecte"
                          class="h-8 sm:h-10 md:h-12 w-auto object-contain"
													loading="lazy"
													width={200}
													height={200}
                        />
                      </div>
                      <!-- Message -->
                      <p
                        class="font-light relative text-base sm:text-lg md:text-[18px] text-[#4c5345] leading-relaxed sm:leading-[198%] text-left before:bg-quoteLeft before:bg-contain before:bg-bottom before:inline-block before:top-0 before:w-6 sm:before:w-8 md:before:w-10 before:h-6 sm:before:h-8 md:before:h-10 before:bg-no-repeat
                          after:bg-quoteRight after:bg-contain after:bg-bottom after:inline-block after:top-0 after:w-6 sm:after:w-8 md:after:w-10 after:h-6 sm:after:h-8 md:after:h-10 after:bg-no-repeat">
                        <span class="mx-1 sm:mx-2">{avis.message}</span>
                      </p>
                      <!-- Name -->
                      <div class="text-lg sm:text-xl md:text-[22px] text-[#4c5354] font-semibold mt-4 sm:mt-6">
                        {avis.nom}
                      </div>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <!-- Pagination bullets -->
          <div class="glide__bullets mt-6 flex justify-center gap-3" data-glide-el="controls[nav]">
            {avis.avis.map((_, i) => (
              <button class="glide__bullet w-3 h-3 rounded-full bg-white opacity-40" data-glide-dir={`=${i}`}></button>
            ))}
          </div>
        </div>
      </div>

      <!-- Bouton pour écrire un avis -->
      <div class="mt-8 sm:mt-10 md:mt-12">
        <a href="https://search.google.com/local/writereview?placeid=ChIJeQyp8WgqDk4RHRbWIqjHSYI" target="_blank"
          rel="noopener noreferrer"
					class="inline-flex items-center gap-2 bg-white text-[#4c5345] px-6 py-3 rounded-md shadow-2xl hover:shadow-lg transition-all duration-300">
          <Picture src={avisGoogle} alt="Google" class="h-6 w-auto" loading="lazy" width={100} height={100} />
          <span class="font-medium">Écrire un avis</span>
        </a>
      </div>
    </div>
  </div>
</section>
<!-- testimonials end -->

	<!-- contact panel -->
	<section class="newsletter bg-accent md:h-[444px] rounded-[10px] flex items-center justify-center xl:mx-56  mx-5 relative overflow-hidden my-10 xl:my-20">
		<!-- container -->
		<div class="newsletter__container container mx-auto">
			<!-- wrapper -->
			<div class="flex flex-col lg:flex-row lg:items-center lg:justify-center lg:gap-x-[58px] max-w-4xl mx-auto py-8 px-8 xl:px-0">
				<!-- text -->
				<div class="flex-1 z-10 text-left">
					<div class="text-2xl uppercase text-white tracking-[2.24px] font-medium">Une question, un projet ?</div>
					<h2 class="mb-4 text-lg text-left text-white">Nous serons ravis de pouvoir vous rencontrer et de répondre à vos envies.</h2>
				</div>
				<!-- form -->
				<div class="flex-1 flex justify-center">
					<div class="flex flex-col md:flex-row relative gap-y-4">
						<a href="contact" class="btn btn-lg btn-white text-sm sm:text-base">Contactez-nous</a>
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- contact panel end-->

</Layout>
