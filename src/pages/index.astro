---
import Layout from '../layouts/Layout.astro';
import LastProjects from '../components/LastProjects.astro';
import avis from '../data/avis.json';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout title="Architecte d'intérieur Toulon" description="Architecte d'intérieur, décoration et aménagement, nous vous accompagnons dans vos projets de rénovation et d'aménagement avec une prestation clé en main.">
	<!-- Section Hero avec slider en fond et texte fixe -->
	<section class="relative h-screen overflow-hidden">
		<!-- Slider en fond (positionné en absolu pour occuper tout le container) -->
		<div class="absolute inset-0 z-0">
			<div class="swiper slider-bg">
				<div class="swiper-wrapper">
					<!-- Slide 1 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/header-web-site-flora-opti.jpg" alt="image-deco-header-website" class="w-full h-screen object-cover">
					</div>
					<!-- Ajoute autant de slides que nécessaire -->
				</div>
				<!-- Pagination du slider -->
				<div class="swiper-pagination"></div>
			</div>
		</div>

		<!-- Texte Hero en overlay (positionné en relatif pour se placer au-dessus du slider) -->
		<div class="relative z-10 flex items-center justify-center md:justify-start h-full px-4 sm:px-6 md:px-8 py-8 sm:py-12">
			<div class="bg-white bg-opacity-90 rounded-md text-left text-primary p-4 sm:p-6 md:p-12 max-w-2xl w-full mx-4 md:mx-0 md:ml-24">
				<!-- logo  -->
				<div class="max-w-[200px] sm:max-w-[250px] md:max-w-[300px] mx-auto sm:mx-0 flex flex-col justify-end items-center sm:items-end mb-6 sm:mb-[30px]">
					<a href="/">
						<img class="w-full h-auto mb-4 sm:mb-[30px]" src="./assets/img/header/logo-transparent.png" alt="Logo Flor'A">
					</a>
				</div>					
				<h1 class="text-xl sm:text-2xl md:text-4xl font-light mb-3 sm:mb-4 text-primary">
					Architecte d'intérieur<br class="hidden sm:block"/> & Maître d'œuvre sur TOULON
				</h1>
				<p class="mb-6 sm:mb-[42px] text-sm sm:text-base md:max-w-xl text-left">
					Flor'A, agence d'architecture d'intérieur certifiée CFAI à Toulon, vous accompagne dans vos projets de rénovation et d'aménagement, intérieurs comme extérieurs.

					Nous concevons des espaces sur mesure, en accord avec votre style, votre budget et votre mode de vie. Sensibles à une architecture responsable et au bien-être des occupants, nous vous guidons de la première esquisse jusqu'au suivi de chantier, pour un projet clé en main.
				</p>
				<div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
					<a href="contact" class="btn btn-lg btn-accent w-full sm:w-auto text-center">Contactez-nous</a>
				</div>
			</div>
		</div>
	</section>
	<!-- Section Hero avec slider en fond et texte fixe -->

	<!-- services -->
	<section class="services my-44">
		<!-- bg description -->
		<div
			class="bg-services bg-cover bg-no-repeat max-w-[1466px] mx-4 xl:mx-auto rounded-[10px] xl:pt-[70px] px-6 xl:px-0 relative h-[368px] flex items-center xl:items-start -z-10">
			<div class="container mx-auto">
				<div class="services__top flex items-center flex-col xl:flex-col xl:mb-[60px]">
					<h2 class="text-3xl text-white flex-1 mb-4 xl:mb-0 text-center xl:text-left">
						Flor'A - Un m² bien pensé en vaut 2 !
					</h2>					
					<p class="text-white flex-1 text-center xl:text-left max-w-2xl xl:max-w-none">Une agence qui met le bâti au service de ses occupants.
					</p>
				</div>
			</div>
		</div>
		<div class="container mx-auto mt-8 xl:-mt-[144px]">
			<div class="grid xl:grid-cols-4 gap-6 px-8 xl:px-0">
				<!-- bloque 1 -->
				<a href="./prestations#etape1"
					class="services__item bg-white p-[30px] rounded-[10px] shadow-custom2 min-h-[200px] flex flex-col justify-between transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
					<div class="text-center">
						<h3 class="h3 mb-[10px]">Conception</h3>
						<p class="font-light leading-normal max-w-[300px] mx-auto">
							De la découverte du lieu à l'étude du projet en plan et en 3D avec rendu réaliste</p>
					</div>
					<span class="text-accent underline text-center">Étape 1</span>
				</a>
				<!-- bloque 2 -->
				<a href="./prestations#etape2"
					class="services__item bg-white p-[30px] rounded-[10px] shadow-custom2 min-h-[200px] flex flex-col justify-between transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
					<div class="text-center">
						<h3 class="h3 mb-[10px]">Démarches administratives</h3>
						<p class="font-light leading-normal max-w-[300px] mx-auto">
							Accompagnement dans les autorisations d'urbanisme et les consultation des entreprises/des fournisseurs.</p>
					</div>
					<span class="text-accent underline text-center">Étape 2</span>
				</a>
				<!-- bloque 3 -->
				<a href="./prestations#etape3"
					class="services__item bg-white p-[30px] rounded-[10px] shadow-custom2 min-h-[200px] flex flex-col justify-between transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
					<div class="text-center">
						<h3 class="h3 mb-[10px]">Suivi de chantier</h3>
						<p class="font-light leading-normal max-w-[300px] mx-auto">
							Coordination des artisans, réunion de chantier hebdomadaires et réception des travaux.</p>
					</div>
					<span class="text-accent underline text-center">Étape 3</span>
				</a>
				<!-- bloque 4 -->
				<a href="./prestations#etape4"
					class="services__item bg-white p-[30px] rounded-[10px] shadow-custom2 min-h-[200px] flex flex-col justify-between transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
					<div class="text-center">
						<h3 class="h3 mb-[10px]">Aménagement</h3>
						<p class="font-light leading-normal max-w-[300px] mx-auto">
							Proposition de mobilier et d'éléments de décoration, dessin de mobilier sur mesure.
						</p>
					</div>
					<span class="text-accent underline text-center">Étape 4</span>
				</a>
			</div>
		</div>
	</section>
	<!-- services end -->


	<!-- slide photo -->
	<section class="photo-slider testimonial pb-[150px] xl:min-h-[800px] xl:py-0 my-12">
		<div class="mx-auto xl:container">
			<!-- slider -->
			<div class="photo-slider swiper min-h-[650px]">
				<!-- Additional required wrapper -->
				<div class="swiper-wrapper slider__photo">
					<!-- Slide 1 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide01.png.avif" alt="Photo 1" class="w-full h-[600px] object-cover">
					</div>
					<!-- Slide 2 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide02.png.avif" alt="Photo 2" class="w-full h-[600px] object-cover">
					</div>
					<!-- Slide 3 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide03.avif" alt="Photo 3" class="w-full h-[600px] object-cover">
					</div>
					<!-- Slide 4 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide04.avif" alt="Photo 3" class="w-full h-[600px] object-cover">
					</div>
					<!-- Slide 5 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide05.avif" alt="Photo 3" class="w-full h-[600px] object-cover">
					</div>
					<!-- Slide 6 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide06.avif" alt="Photo 3" class="w-full h-[600px] object-cover">
					</div>
					<!-- Slide 7 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide07.avif" alt="Photo 3" class="w-full h-[600px] object-cover">
					</div>
					<!-- Slide 8 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide08.avif" alt="Photo 3" class="w-full h-[600px] object-cover">
					</div>
					<!-- Slide 9 -->
					<div class="swiper-slide">
						<img src="./assets/img/sliderphoto/slide09.avif" alt="Photo 3" class="w-full h-[600px] object-cover">
					</div>
				</div>
				<!-- Swiper pagination -->
				<div class="swiper-pagination"></div>
			</div>
		</div>
	</section>
	<!-- slide photo end -->

	<LastProjects  />

<!-- testimonials -->
<section class="testimonial bg-testimonials bg-cover bg-right bg-no-repeat p-8 sm:p-8 md:p-12 my-48">
  <div class="testimonial__container container mx-auto">
    <div class="flex flex-col items-center">
      <h2 class="h2 text-white text-center my-4 sm:my-6 md:my-8 text-2xl sm:text-3xl md:text-4xl">
        Vos avis comptent et nous vous en remercions
      </h2>
      <!-- Glide slider -->
      <div class="w-full max-w-[710px] px-4 sm:px-0">
        <div class="glide" id="testimonial-slider">
          <div class="glide__track" data-glide-el="track">
            <ul class="glide__slides">
              {avis.avis.map((avis) => (
                <li class="glide__slide">
                  <div class="h-full flex flex-col justify-center items-center py-8">
                    <div class="max-w-[680px] mx-auto text-center px-4">
                      <!-- Google Logo -->
                      <div class="flex justify-center mb-4 sm:mb-6">
                        <img src="/assets/img/testimonials/avis-google.avif" alt="Google"
                          class="h-8 sm:h-10 md:h-12 w-auto object-contain" />
                      </div>
                      <!-- Message -->
                      <p
                        class="font-light relative text-base sm:text-lg md:text-[18px] text-[#4c5345] leading-relaxed sm:leading-[198%] text-center before:bg-quoteLeft before:bg-contain before:bg-bottom before:inline-block before:top-0 before:w-6 sm:before:w-8 md:before:w-10 before:h-6 sm:before:h-8 md:before:h-10 before:bg-no-repeat
                          after:bg-quoteRight after:bg-contain after:bg-bottom after:inline-block after:top-0 after:w-6 sm:after:w-8 md:after:w-10 after:h-6 sm:after:h-8 md:after:h-10 after:bg-no-repeat">
                        <span class="mx-1 sm:mx-2">{avis.message}</span>
                      </p>
                      <!-- Name -->
                      <div class="text-lg sm:text-xl md:text-[22px] text-[#4c5354] font-semibold mt-4 sm:mt-6">
                        {avis.nom}
                      </div>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <!-- Pagination bullets -->
          <div class="glide__bullets mt-6 flex justify-center gap-3" data-glide-el="controls[nav]">
            {avis.avis.map((_, i) => (
              <button class="glide__bullet w-3 h-3 rounded-full bg-white opacity-40" data-glide-dir={`=${i}`}></button>
            ))}
          </div>
        </div>
      </div>

      <!-- Bouton pour écrire un avis -->
      <div class="mt-8 sm:mt-10 md:mt-12">
        <a href="https://search.google.com/local/writereview?placeid=ChIJeQyp8WgqDk4RHRbWIqjHSYI" target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-white text-[#4c5345] px-6 py-3 rounded-md shadow-md hover:shadow-lg transition-all duration-300">
          <img src="/assets/img/testimonials/avis-google.avif" alt="Google" class="h-6 w-auto" />
          <span class="font-medium">Écrire un avis</span>
        </a>
      </div>
    </div>
  </div>
</section>
<!-- testimonials end -->

	<!-- contact panel -->
	<section class="newsletter bg-accent md:h-[444px] rounded-[10px] flex items-center justify-center xl:mx-56  mx-5 relative overflow-hidden my-44">
		<!-- container -->
		<div class="newsletter__container container mx-auto">
			<!-- wrapper -->
			<div class="flex flex-col lg:flex-row lg:items-center lg:justify-center lg:gap-x-[58px] max-w-4xl mx-auto py-8 px-8 xl:px-0">
				<!-- text -->
				<div class="flex-1 z-10 text-left">
					<div class="text-2xl uppercase text-white tracking-[2.24px] font-medium">Une question, un projet ?</div>
					<h2 class="mb-4 text-lg text-left text-white">Nous serons ravis de pouvoir vous rencontrer et de répondre à vos envies.</h2>
				</div>
				<!-- form -->
				<div class="flex-1 flex justify-center">
					<div class="flex flex-col md:flex-row relative gap-y-4">
						<a href="contact" class="btn btn-lg btn-white text-sm sm:text-base">Contactez-nous</a>
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- contact panel end-->



</Layout>
