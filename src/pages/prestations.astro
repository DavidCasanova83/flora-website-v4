---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";

---

<Layout title="Mes prestations" description="Découvrez mes prestations concernant l'architecture d'intérieur.">

  <!-- hero -->
  <section class="heropy-12 mb-12 xl:pt-12 xl:pb-0 overflow-hidden">
    <div class="container mx-auto h-full flex flex-col justify-center items-center xl:px-24">
      <h1 class="h1 mb-6">Prestations</h1>
      <p class="mb-[16px] md:max-w-xl text-justify">
        Vous souhaitez réorganiser et revaloriser votre lieu de vie ou votre local professionnel, recomposer les
        volumes, créer de nouveaux espaces, jouer avec la lumière ?

      </p>
      <p class="mb-[16px] md:max-w-xl text-justify">
        Je vous accompagne pour la réalisation de vos projets intérieurs et ou extérieurs que ce soit à travers une
        visite conseil ou une réalisation clé en main.
      </p>
      <p class="mb-[16px] md:max-w-xl text-justify">
        Que vous soyez particuliers ou professionnels, mon objectif est de vous proposer un projet de rénovation et de
        décoration sur mesure, de redessiner votre intérieur tout en respectant les diverses contraintes d’espace, de
        structure, de budget et environnementales.</p>
    </div>
  </section>
  <!-- hero end -->


  <!-- blog 01-->
  <section class="blog">
    <div class="container mx-auto">
      <div class="flex flex-col xl:flex-row gap-y-6 xl:gap-y-0 xl:gap-x-6 items-center xl:justify-between mb-[50px]">
        <!-- post 1 -->
        <div
          class="blog__post min-w-[420px] shadow-custom2 rounded-[10px] overflow-hidden cursor-pointer group min-h-[620px]">
          <div class="relative overflow-hidden h-[500px]">
            <img class="group-hover:scale-110 transition-all duration-500 h-full w-full object-cover"
              src="./assets/img/PRESTATIONS/Flora-2.avif" alt="">
            <div
              class="bg-accent-tertiary absolute bottom-0 right-0 text-white text-base tracking-[2.24px] font-medium uppercase py-[6px] px-[18px]">
              En savoir plus
            </div>
          </div>
          <div class="px-5 py-6 h-[160px] flex flex-col justify-between">
            <h4 class="h4 mb-[10px]">Visite conseil à domicile</h4>
            <p class="font-light">RDV à votre domicile pour vous conseiller et vous guider sur vos projets durant 1h.
            </p>
          </div>
        </div>
        <!-- post 2 -->
        <div
          class="blog__post min-w-[420px] shadow-custom2 rounded-[10px] overflow-hidden cursor-pointer group min-h-[620px]">
          <div class="relative overflow-hidden h-[500px]">
            <img class="group-hover:scale-110 transition-all duration-500 h-full w-full object-cover"
              src="./assets/img/PRESTATIONS/Flora-3.avif" alt="">
            <div
              class="bg-accent-tertiary absolute bottom-0 right-0 text-white text-base tracking-[2.24px] font-medium uppercase py-[6px] px-[18px]">
              En savoir plus
            </div>
          </div>
          <div class="px-5 py-6 h-[160px] flex flex-col justify-between">
            <h4 class="h4 mb-[10px]">Proposition d'aménagement</h4>
            <p class="font-light">Remise d'un dossier d'étude complet préparatoire avant travaux.</p>
          </div>
        </div>
        <!-- post 3 -->
        <div
          class="blog__post min-w-[420px] shadow-custom2 rounded-[10px] overflow-hidden cursor-pointer group min-h-[620px]">
          <div class="relative overflow-hidden h-[500px]">
            <img class="group-hover:scale-110 transition-all duration-500 h-full w-full object-cover"
              src="./assets/img/PRESTATIONS/Flora-4.avif" alt="">
            <div
              class="bg-accent-tertiary absolute bottom-0 right-0 text-white text-base tracking-[2.24px] font-medium uppercase py-[6px] px-[18px]">
              En savoir plus
            </div>
          </div>
          <div class="px-5 py-6 h-[160px] flex flex-col justify-between">
            <h4 class="h4 mb-[10px]">Prestation clé en main</h4>
            <p class="font-light">Prise en charge complète de votre projet d'aménagement intérieur avec une réception
              clé en main.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- blog 01 end-->





</Layout>