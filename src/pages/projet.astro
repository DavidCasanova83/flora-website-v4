---
import Layout from '../layouts/Layout.astro';
import { getPages } from '../lib/notion';
import { mapPageData } from '../lib/parseNotion';
import type { ParsedPage } from '../types/ParsedPage';
import "../styles/global.css";

// 🔁 Récupère et mappe toutes les pages en objets simplifiés
const rawPages = await getPages();
const parsedPages: ParsedPage[] = rawPages.map(mapPageData);

// 🎯 Filtre les articles ayant un statut "En ligne" ou "En Cours" ET le label "projet"
const articles = parsedPages
  .filter(p =>
    ["En ligne", "En Cours"].includes(p.status ?? "") &&
    p.label === "projet"
  )
  .sort((a, b) => {
    // Si les deux articles ont une date, on trie par date décroissante
    if (a.date && b.date) {
      return new Date(b.date).getTime() - new Date(a.date).getTime();
    }
    // Si un article n'a pas de date, il passe après
    if (!a.date) return 1;
    if (!b.date) return -1;
    return 0;
  });
---

<Layout>
  <!-- hero -->
  <section class="heropy-12 mb-12 xl:pt-12 xl:pb-0 overflow-hidden">
    <div class="container mx-auto h-full flex flex-col justify-center items-center xl:px-24">
      <h1 class="h1 mb-6">Projets d'études</h1>
      <p class="mb-[16px] md:max-w-xl text-justify">
        Découvrez notre portfolio de projets réalisés. Chaque projet est une histoire unique,
        une transformation d'espace qui allie esthétique, fonctionnalité et bien-être.
      </p>
      <p class="mb-[16px] md:max-w-xl text-justify">
        Notre approche personnalisée vous accompagne dans la création d'espaces qui reflètent votre personnalité et répondent
        à vos besoins spécifiques, que ce soit pour une rénovation complète ou une simple réorganisation d'espace.
      </p>
    </div>
  </section>
  <!-- hero end -->

  <section class="p-6 md:p-12 bg-gradient-to-b from-gray-50 to-white min-h-screen">
    <div class="container mx-auto max-w-7xl">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          articles.map(article => {
            const {
              title,
              slug,
              excerpt,
              date,
              imagePresentation,
              status
            } = article;

            const isEnCours = status === "En Cours";

            const content = (
              <div class={`group block bg-white rounded-[10px] shadow-lg transition overflow-hidden relative
                ${isEnCours ? 'opacity-50 pointer-events-none' : 'hover:shadow-xl'}`}>

                {/* Badge En cours */}
                {isEnCours && (
                  <span class="absolute top-3 left-3 bg-yellow-500 text-white text-xs font-bold px-2 py-1 rounded shadow z-10">
                    En cours
                  </span>
                )}

                {imagePresentation && (
                  <div class="aspect-square w-full overflow-hidden">
                    <img src={imagePresentation} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                  </div>
                )}

                <div class="p-5 flex flex-col h-[180px]">
                  <h2 class="text-xl font-semibold uppercase text-gray-800 group-hover:text-indigo-600 transition">{title}</h2>
                  <p class="mt-2 text-gray-600 text-[14px] line-clamp-2 flex-grow">{excerpt}</p>
                </div>
              </div>
            );

            // 🔗 Lien cliquable seulement si l'article est en ligne
            return isEnCours
              ? <div>{content}</div>
              : <a href={`/projet/${slug}`}>{content}</a>;
          })
        }
      </div>
    </div>
  </section>
</Layout> 