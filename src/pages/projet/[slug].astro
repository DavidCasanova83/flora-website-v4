---
import Layout from '../../layouts/Layout.astro';
import { getPages } from '../../lib/notion';
import { mapPageData } from '../../lib/parseNotion';
import type { ParsedPage } from '../../types/ParsedPage';
import "../../styles/global.css";

// 🔁 Génération des routes statiques à partir des slugs Notion
export async function getStaticPaths() {
  const rawPages = await getPages();
  const parsedPages: ParsedPage[] = rawPages.map(mapPageData);

  const paths = parsedPages
    .filter(page => !!page.slug)
    .map(page => ({
      params: { slug: page.slug! }
    }));

  return paths;
}

// 🔍 Récupération du slug de l'URL
const { slug } = Astro.params;

const rawPages = await getPages();
const parsedPages: ParsedPage[] = rawPages.map(mapPageData);

// 🎯 On cherche la page correspondant au slug
const page = parsedPages.find(p => p.slug === slug);

if (!page) {
  throw new Error(`Article introuvable pour le slug : ${slug}`);
}

// ✅ Extraction des données typées
const {
  title,
  slug: slugText,
  status,
  published,
  btnText,
  excerpt,
  content,
  imagePresentation,
  images = [],
  link,
  date,
  rank,
  created,
  edited,
  label,
  montexte,
  content2,
  content3,
  content4,
  content5,
  images02 = [],
  images03 = [],
  images04 = [],
  images05 = [],
  images06 = []
} = page;

// ✅ Formatage de la date de modification (ex: "23 mars 2025")
const editedDate = edited
  ? new Date(edited).toLocaleDateString("fr-FR", {
      year: "numeric",
      month: "long",
      day: "numeric"
    })
  : null;

  const description = `${title} - ${excerpt}`;
---

<Layout title={title} description={description}>
  <article class="w-4/5 mx-auto p-4 md:p-8">
    <div class="flex flex-col md:flex-row gap-8 md:gap-16 mb-10">
      {/* Image principale */}
      {imagePresentation && (
        <div class="md:w-1/4 h-[300px] md:h-[400px]">
          <img src={imagePresentation} alt={title} class="w-full h-full object-cover shadow-md" />
        </div>
      )}
    
      {/* Contenu à droite */}
      <div class="md:w-3/4">
        <header class="mb-6">
          <h1 class="text-3xl md:text-4xl uppercase font-bold text-gray-900 mb-4">{title}</h1>
        </header>
    
        {/* Contenu principal */}
        <div class="prose prose-lg text-black max-w-none whitespace-pre-line leading-snug text-justify">
          {content}
        </div>
      </div>
    </div>

    {/* Galerie d'images associées */}
    {images.length > 0 && (
      <section class="mb-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {images.map((img, i) => (
            <div class={`group relative overflow-hidden ${i === 0 ? 'md:col-span-2' : ''}`}>
              <img 
                src={img} 
                alt={`Image ${i + 1}`} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
              />
              <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-20 transition-all duration-300"></div>
            </div>
          ))}
        </div>
      </section>
    )}

    {content2 && content2.trim() !== '' && (
      <div class="prose prose-lg text-black max-w-none whitespace-pre-line leading-snug text-justify mt-12 px-8 mb-16">
        {content2}
      </div>
    )}

    {/* Galerie d'images associées 02 */}
    {images02 && images02.length > 0 && (
      <section class="mb-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          {images02.map((img, i) => (
            <div class={`group relative overflow-hidden ${
              i % 5 === 0 ? 'md:col-span-2 md:row-span-2' : 
              i % 3 === 0 ? 'md:col-span-2' : 
              'md:col-span-1'
            }`}>
              <img 
                src={img} 
                alt={`Image ${i + 1}`} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
              />
              <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-20 transition-all duration-300"></div>
            </div>
          ))}
        </div>
      </section>
    )}

    {content3 && content3.trim() !== '' && (
      <div class="prose prose-lg text-black max-w-none whitespace-pre-line leading-snug text-justify mt-12 px-8 mb-16">
        {content3}
      </div>
    )}

    {/* Galerie d'images associées 03 */}
    {images03 && images03.length > 0 && (
      <section class="mb-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          {images03.map((img, i) => (
            <div class={`group relative overflow-hidden ${
              i % 5 === 0 ? 'md:col-span-2 md:row-span-2' : 
              i % 3 === 0 ? 'md:col-span-2' : 
              'md:col-span-1'
            }`}>
              <img 
                src={img} 
                alt={`Image ${i + 1}`} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
              />
              <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-20 transition-all duration-300"></div>
            </div>
          ))}
        </div>
      </section>
    )}

    {content4 && content4.trim() !== '' && (
      <div class="prose prose-lg text-black max-w-none whitespace-pre-line leading-snug text-justify mt-12 px-8 mb-16">
        {content4}
      </div>
    )}

    {/* Galerie d'images associées 04 */}
    {images04 && images04.length > 0 && (
      <section class="mb-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {images04.map((img, i) => (
            <div class={`group relative overflow-hidden ${i === 0 ? 'md:col-span-2' : ''}`}>
              <img 
                src={img} 
                alt={`Image ${i + 1}`} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
              />
              <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-20 transition-all duration-300"></div>
            </div>
          ))}
        </div>
      </section>
    )}

    {content5 && content5.trim() !== '' && (
      <div class="prose prose-lg text-black max-w-none whitespace-pre-line leading-snug text-justify mt-12 px-8 mb-16">
        {content5}
      </div>
    )}

    {/* Galerie d'images associées 06 - Une seule colonne */}
    {images06 && images06.length > 0 && (
      <section class="mb-16 w-full">
        <div class="flex flex-col gap-8 w-full">
          {images06.map((img: string, i: number) => (
            <div class="group relative overflow-hidden w-full">
              <img 
                src={img} 
                alt={`Image ${i + 1}`} 
                class="w-full h-auto object-contain transition-transform duration-500 group-hover:scale-105" 
              />
              <div class="absolute inset-0 bg-black bg-opacity-0 transition-all duration-300"></div>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* Galerie d'images associées 05 */}
    {images05 && images05.length > 0 && (
      <section class="mb-16">
        <div class="flex flex-wrap gap-6 justify-center">
          {images05.map((img, i) => (
            <div class="group relative overflow-hidden aspect-[3/4] w-full sm:w-[calc(50%-12px)] md:w-[calc(33.333%-16px)]">
              <img 
                src={img} 
                alt={`Image ${i + 1}`} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
              />
              <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-20 transition-all duration-300"></div>
            </div>
          ))}
        </div>
      </section>
    )}


  </article>
</Layout>
