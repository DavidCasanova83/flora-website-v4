---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";

---

<Layout title="Réalisations" description="Découvrez tous mes projets">

  <!-- hero -->
  <section class="heropy-12 mb-12 xl:pt-12 xl:pb-0 overflow-hidden">
    <div class="container mx-auto h-full flex flex-col justify-center items-center xl:px-24">
      <h1 class="h1 mb-6">Réalisations</h1>
      <p class="mb-[16px] md:max-w-xl text-justify">
        Je vous accompagne pour la réalisation de vos projets de rénovation intérieur / extérieur et de décoration sur
        mesure.

      </p>
      <p class="mb-[16px] md:max-w-xl text-justify">
        Que vous soyez particuliers ou professionnels, mon objectif est de vous proposer un projet sur mesure, de
        redessiner votre intérieur tout en respectant les diverses contraintes d’espace, de structure et de budget. Des
        matériaux locaux, bio-sourcés, écologiques et ayant un faible impact sur l'environnement vous seront proposés
        pour construire ensemble une architecture durable et responsable.
      </p>
    </div>
  </section>
  <!-- hero end -->

  <!-- blog -->
  <section class="blog">
    <div class="container mx-auto">
      <h2 class="blog__title h2 mb-[50px] text-center xl:text-left">Architecture d'intérieur</h2>
      <!-- blog post  -->
      <div class="flex flex-col xl:flex-row gap-y-6 xl:gap-y-0 xl:gap-x-6 items-center xl:justify-between mb-[50px]">
        <!-- post 1 -->
        <a href="construction" class="block">
          <div class="blog__post max-w-[420px] shadow-custom2 rounded-[10px] overflow-hidden cursor-pointer group">
            <div class="relative overflow-hidden  h-[300px]">
              <img class="group-hover:scale-125 transition-all duration-500 object-cover scale-110"
                src="./assets/img/REALISATIONS/archi01.avif" alt="">
            </div>
            <div class="px-5 py-6 h-[160px] flex flex-col justify-between">
              <h4 class="h4 mb-[10px]">ESCLANGON</h4>
              <p class="font-light">Rénovation intérieure et extérieure d'une villa
              </p>
            </div>
          </div>
        </a>
        <!-- post 2 -->
