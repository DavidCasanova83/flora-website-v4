---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
import LastArchitecture from '../components/LastArchitecture.astro';
import LastProjets from '../components/LastProjets.astro';
---

<Layout title="Mes Réalisations" description="Découvrez tous mes projets réalisés.">

  <!-- hero -->
  <section class="hero mb-10 xl:pt-12 xl:pb-0 overflow-hidden">
    <div class="container mx-auto h-full flex flex-col justify-center items-center xl:px-24">
      <h1 class="h1 mb-6">Réalisations</h1>
      <p class="mb-[16px] md:max-w-xl text-left">
        Nous apportons une attention particulière à chaque projet pour le rendre unique et personnalisé. Ainsi, nous vous accompagnons tout au long de la réalisation de vos projets de rénovation intérieure et extérieure, depuis l’esquisse jusqu’au suivi de chantier. Que vous soyez un particulier ou un professionnel, notre objectif est de concevoir un projet sur mesure qui redessine votre intérieur, tout en tenant compte des contraintes d’espace, de structure et de budget. 
      </p>
    </div>
  </section>
  <!-- hero end -->

  <LastArchitecture />
  <LastProjets />

</Layout>