---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
import LastArchitecture from '../components/LastArchitecture.astro';
import LastDecoration from '../components/LastDecoration.astro';
import LastProjets from '../components/LastProjets.astro';
---

<Layout title="Réalisations" description="Découvrez tous mes projets">

  <!-- hero -->
  <section class="heropy-12 mb-12 xl:pt-12 xl:pb-0 overflow-hidden">
    <div class="container mx-auto h-full flex flex-col justify-center items-center xl:px-24">
      <h1 class="h1 mb-6">Réalisations</h1>
      <p class="mb-[16px] md:max-w-xl text-justify">
        Je vous accompagne pour la réalisation de vos projets de rénovation intérieur / extérieur et de décoration sur
        mesure.

      </p>
      <p class="mb-[16px] md:max-w-xl text-justify">
        Que vous soyez particuliers ou professionnels, mon objectif est de vous proposer un projet sur mesure, de
        redessiner votre intérieur tout en respectant les diverses contraintes d’espace, de structure et de budget. Des
        matériaux locaux, bio-sourcés, écologiques et ayant un faible impact sur l'environnement vous seront proposés
        pour construire ensemble une architecture durable et responsable.
      </p>
    </div>
  </section>
  <!-- hero end -->

  <LastArchitecture />
  <LastDecoration />
  <LastProjets />

</Layout>